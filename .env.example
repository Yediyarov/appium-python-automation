# Copy to .env for local use if you prefer exporting variables from a file.
# The framework reads environment variables directly.

# Required for the first local run unless the app is already installed and
# APP_PACKAGE/APP_ACTIVITY are configured.
TASKS_APK_PATH=/absolute/path/to/tasks-org-15.9.apk

# Default Appium 2/3 local server URL.
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Android emulator/device configuration.
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=

# Appium can install and launch from TASKS_APK_PATH. If you want to launch an
# already installed app instead, set APP_PACKAGE and APP_ACTIVITY.
APP_PACKAGE=org.tasks
APP_ACTIVITY=com.todoroo.astrid.activity.TaskListActivity

# Keep false for deterministic local runs unless debugging existing app state.
NO_RESET=false
AUTO_GRANT_PERMISSIONS=true
